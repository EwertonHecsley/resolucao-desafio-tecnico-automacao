# Project
PROJECT_NAME=IA Classifier API
VERSION=0.1.0
ENVIRONMENT=development

# AI Provider (SPEC-03)
# Opções: fake | gemini | groq | openai  (padrão: fake, sem chave)
AI_PROVIDER=fake

# Fallback: lista separada por vírgula, tentada nesta ordem após o provedor
# principal. Deixe vazio para desativar.
# Ex.: AI_FALLBACK_PROVIDERS=groq,fake
AI_FALLBACK_PROVIDERS=

# Timeout (em segundos) para chamadas aos provedores de IA
AI_TIMEOUT_SECONDS=20

# Gemini (necessário se AI_PROVIDER=gemini; modelo vigente: gemini-2.0-flash)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Groq (necessário se AI_PROVIDER=groq; modelo vigente: llama-3.3-70b-versatile)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (necessário se AI_PROVIDER=openai; modelo vigente: gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Autenticação (SPEC-06)
# Vazio desativa a verificação do header X-API-Key nas rotas POST (útil em dev).
API_KEY=your-api-key-here

# Database (SPEC-04)
# Use localhost quando a API roda na máquina e o Postgres no Docker.
# Dentro da rede do compose (SPEC-08), troque localhost por postgres.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/classificador
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=classificador

# n8n Webhook (SPEC-05)
# Deixe N8N_WEBHOOK_URL vazio para desativar notificações (NullNotifier).
# A API deve apontar para /webhook/classificador (PRODUÇÃO): exige fluxo ATIVO no n8n.
# Não use /webhook-test/... — só funciona com o botão "Listen for test event" ativo.
# Dentro do Docker Compose o host é "n8n"; fora dele use "localhost".
N8N_WEBHOOK_URL=http://localhost:5678/webhook/classificador
# Exemplo dentro do compose: http://n8n:5678/webhook/classificador
N8N_WEBHOOK_SECRET=your-webhook-secret-here
# Timeout em segundos para o POST ao webhook (padrão: 5)
N8N_TIMEOUT_SECONDS=5