# Project
PROJECT_NAME=IA Classifier API
VERSION=0.1.0
ENVIRONMENT=development

# AI Provider
# Options: openai, google, anthropic
AI_PROVIDER=openai

# OpenAI (necessário se AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your-api-key-here

# Google AI (necessário se AI_PROVIDER=google)
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic (necessário se AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database (opcional - para próximos specs)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ia_classifier

# n8n Webhook (opcional - para próximos specs)
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/ai-classifier
N8N_WEBHOOK_SECRET=your-webhook-secret-here